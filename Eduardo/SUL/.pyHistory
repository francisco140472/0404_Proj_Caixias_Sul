import arcpy import os from collections import defaultdict  # === 1. CAMINHOS PARA OS SHAPEFILES === # Usando o arquivo que você já tem no projeto in_pontos = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_finais.shp" out_linhas = r"C:\Projetos\Caixias_Sul\Eduardo\linhas_agrupadas_finais.shp"  arcpy.env.overwriteOutput = True sr = arcpy.Describe(in_pontos).spatialReference  # === 2. CRIAR SHAPEFILE DE LINHAS === arcpy.management.CreateFeatureclass(     out_path=os.path.dirname(out_linhas),     out_name=os.path.basename(out_linhas),     geometry_type="POLYLINE",     spatial_reference=sr )  # Adicionar a coluna para o nome da descrição arcpy.management.AddField(out_linhas, "Descricao", "TEXT", field_length=50)  # === 3. AGRUPAR PONTOS PELA DESCRIÇÃO E ORDENAR === print("Lendo pontos finais e agrupando pela descrição...") grupos_de_linhas = defaultdict(list)  # Lendo as colunas do seu shapefile (XY, PointID e Descriptio) campos = ["SHAPE@XY", "PointID", "Descriptio"]   with arcpy.da.SearchCursor(in_pontos, campos) as cursor:     for row in cursor:         x, y = row[0]         pt_id = row[1]         desc = row[2]                  # Só adiciona se a descrição não for vazia         if desc and str(desc).strip() != "":             # Guarda o PointID junto com as coordenadas para podermos ordenar depois             grupos_de_linhas[desc].append((pt_id, x, y))  # === 4. DESENHAR AS LINHAS === print("Desenhando as linhas corrigidas...")  with arcpy.da.InsertCursor(out_linhas, ["SHAPE@", "Descricao"]) as cursor:     # Passa por cada grupo criado (ex: grupo do 'bc', grupo do 'conc.')     for desc, lista_pontos in grupos_de_linhas.items():                  # Uma linha precisa de pelo menos 2 pontos para existir         if len(lista_pontos) > 1:             # Ordena os pontos DESSE grupo específico do menor pro maior PointID             lista_pontos.sort(key=lambda p: p[0])                          # Cria a geometria da linha             array_vertices = arcpy.Array()             for p in lista_pontos:                 x_ponto = p[1]                 y_ponto = p[2]                 array_vertices.add(arcpy.Point(x_ponto, y_ponto))                          linha_geom = arcpy.Polyline(array_vertices, sr)                          # Salva a linha no arquivo             cursor.insertRow([linha_geom, desc])  # === 5. ADICIONAR AO MAPA === try:     aprx = arcpy.mp.ArcGISProject("CURRENT")     mapa = aprx.activeMap     if mapa:         mapa.addDataFromPath(out_linhas)         print("🎨 Linhas adicionadas ao mapa! (Lembre de usar Symbology -> Unique Values na coluna 'Descricao')") except Exception as e:     pass  print(f"✅ Arquivo de linhas corrigido salvo em: {out_linhas}")
import arcpy import os import math from collections import defaultdict  # === 1. CAMINHOS PARA OS SHAPEFILES === in_pontos = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_finais.shp" out_linhas = r"C:\Projetos\Caixias_Sul\Eduardo\linhas_por_proximidade.shp"  arcpy.env.overwriteOutput = True sr = arcpy.Describe(in_pontos).spatialReference  # Função para calcular a distância matemática entre dois pontos (Geometria Euclidiana) def calcular_distancia(p1, p2):     return math.sqrt((p2[0] - p1[0])**2 + (p2[1] - p1[1])**2)  # === 2. CRIAR SHAPEFILE DE LINHAS === arcpy.management.CreateFeatureclass(     out_path=os.path.dirname(out_linhas),     out_name=os.path.basename(out_linhas),     geometry_type="POLYLINE",     spatial_reference=sr )  arcpy.management.AddField(out_linhas, "Descricao", "TEXT", field_length=50)  # === 3. AGRUPAR PONTOS PELA DESCRIÇÃO === print("Lendo pontos e agrupando pela descrição...") grupos_de_pontos = defaultdict(list)  with arcpy.da.SearchCursor(in_pontos, ["SHAPE@XY", "PointID", "Descriptio"]) as cursor:     for row in cursor:         x, y = row[0]         pt_id = row[1]         desc = row[2]                  if desc and str(desc).strip() != "":             # Guardamos X, Y e o ID             grupos_de_pontos[desc].append((x, y, pt_id))  # === 4. CONECTAR PELO MAIS PRÓXIMO === print("Calculando rotas de proximidade e desenhando formas...")  with arcpy.da.InsertCursor(out_linhas, ["SHAPE@", "Descricao"]) as cursor:     for desc, lista_pontos in grupos_de_pontos.items():                  if len(lista_pontos) > 1:             pontos_nao_visitados = lista_pontos.copy()                          # Começa do ponto com menor ID dentro desse grupo para ter uma referência             pontos_nao_visitados.sort(key=lambda p: p[2])                          ponto_atual = pontos_nao_visitados.pop(0)             pontos_ordenados = [ponto_atual]                          # Encontra o vizinho mais próximo repetidamente             while pontos_nao_visitados:                 ponto_mais_proximo = None                 menor_distancia = float('inf')                                  for p in pontos_nao_visitados:                     dist = calcular_distancia((ponto_atual[0], ponto_atual[1]), (p[0], p[1]))                     if dist < menor_distancia:                         menor_distancia = dist                         ponto_mais_proximo = p                                  pontos_ordenados.append(ponto_mais_proximo)                 pontos_nao_visitados.remove(ponto_mais_proximo)                 ponto_atual = ponto_mais_proximo                          # FECHAR O POLÍGONO: Se tem 3 ou mais pontos, liga o último de volta ao primeiro             if len(pontos_ordenados) >= 3:                 pontos_ordenados.append(pontos_ordenados[0])              # Cria a linha física no mapa             array_vertices = arcpy.Array()             for p in pontos_ordenados:                 array_vertices.add(arcpy.Point(p[0], p[1]))                          linha_geom = arcpy.Polyline(array_vertices, sr)             cursor.insertRow([linha_geom, desc])  # === 5. ADICIONAR AO MAPA === try:     aprx = arcpy.mp.ArcGISProject("CURRENT")     mapa = aprx.activeMap     if mapa:         mapa.addDataFromPath(out_linhas)         print("🎨 Formas adicionadas ao mapa!") except Exception as e:     pass  print(f"✅ Formas otimizadas por proximidade salvas em: {out_linhas}")
import arcpy import os import math from collections import defaultdict  # === 1. CAMINHOS PARA OS SHAPEFILES === in_pontos = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_finais.shp" out_linhas = r"C:\Projetos\Caixias_Sul\Eduardo\linhas_contorno_perfeito.shp"  arcpy.env.overwriteOutput = True sr = arcpy.Describe(in_pontos).spatialReference  # === 2. CRIAR SHAPEFILE DE LINHAS === arcpy.management.CreateFeatureclass(     out_path=os.path.dirname(out_linhas),     out_name=os.path.basename(out_linhas),     geometry_type="POLYLINE",     spatial_reference=sr )  arcpy.management.AddField(out_linhas, "Descricao", "TEXT", field_length=50)  # === 3. AGRUPAR PONTOS PELA DESCRIÇÃO === print("Lendo pontos e agrupando pela descrição...") grupos_de_pontos = defaultdict(list)  with arcpy.da.SearchCursor(in_pontos, ["SHAPE@XY", "Descriptio"]) as cursor:     for row in cursor:         x, y = row[0]         desc = row[1]                  # Ignora campos vazios         if desc and str(desc).strip() != "":             grupos_de_pontos[desc].append((x, y))  # === 4. CRIAR OS CONTORNOS COMO PONTEIROS DE UM RELÓGIO === print("Calculando o centro geométrico e desenhando os contornos sem cruzamentos...")  with arcpy.da.InsertCursor(out_linhas, ["SHAPE@", "Descricao"]) as cursor:     for desc, lista_pontos in grupos_de_pontos.items():                  # Se tiver 3 ou mais pontos, podemos fechar um polígono perfeito         if len(lista_pontos) > 2:             # 1. Encontra o ponto central (Centróide) de todos os pontos desse grupo             centro_x = sum(p[0] for p in lista_pontos) / len(lista_pontos)             centro_y = sum(p[1] for p in lista_pontos) / len(lista_pontos)                          # 2. Ordena os pontos ao redor desse centro usando o ângulo (matemática circular)             lista_pontos.sort(key=lambda p: math.atan2(p[1] - centro_y, p[0] - centro_x))                          # 3. Fecha o desenho voltando para o primeiro ponto da lista             lista_pontos.append(lista_pontos[0])                      elif len(lista_pontos) < 2:             # Se for apenas 1 ponto isolado (como um poste ou hidrômetro), não faz linha e pula             continue          # Desenha a linha conectando os pontos na nova ordem circular         array_vertices = arcpy.Array()         for p in lista_pontos:             array_vertices.add(arcpy.Point(p[0], p[1]))                  linha_geom = arcpy.Polyline(array_vertices, sr)         cursor.insertRow([linha_geom, desc])  # === 5. ADICIONAR AO MAPA === try:     aprx = arcpy.mp.ArcGISProject("CURRENT")     mapa = aprx.activeMap     if mapa:         mapa.addDataFromPath(out_linhas)         print("🎨 Contornos adicionados ao mapa com sucesso!") except Exception as e:     pass  print(f"✅ Arquivo de contornos perfeitos gerado em: {out_linhas}")
import arcpy import os import math from collections import defaultdict  # === 1. CAMINHOS PARA OS SHAPEFILES === in_pontos = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_finais.shp" out_pontos_proj = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_projetados.shp" out_linhas = r"C:\Projetos\Caixias_Sul\Eduardo\linhas_contorno_perfeito.shp"  arcpy.env.overwriteOutput = True  # === 2. PROJETAR PARA COORDENADAS PLANAS (UTM) === print("1. Convertendo pontos de Graus para UTM...")  # EPSG: 32617 = WGS 84 / UTM zone 17N (Sistema padrão da Flórida) # Nota: Se quiser voltar para Pés (State Plane East), troque 32617 por 2236 sr_projetado = arcpy.SpatialReference(32617)  arcpy.management.Project(     in_dataset=in_pontos,     out_dataset=out_pontos_proj,     out_coor_system=sr_projetado )  # === 3. CRIAR SHAPEFILE DE LINHAS === print("2. Preparando arquivo de linhas contínuas...") arcpy.management.CreateFeatureclass(     out_path=os.path.dirname(out_linhas),     out_name=os.path.basename(out_linhas),     geometry_type="POLYLINE",     spatial_reference=sr_projetado )  arcpy.management.AddField(out_linhas, "Descricao", "TEXT", field_length=50)  # === 4. AGRUPAR PONTOS PELA DESCRIÇÃO (Usando os pontos já projetados) === print("3. Agrupando pontos e calculando matemática radial...") grupos_de_pontos = defaultdict(list)  with arcpy.da.SearchCursor(out_pontos_proj, ["SHAPE@XY", "Descriptio"]) as cursor:     for row in cursor:         x, y = row[0]         desc = row[1]                  if desc and str(desc).strip() != "":             grupos_de_pontos[desc].append((x, y))  # === 5. DESENHAR OS CONTORNOS SEM CRUZAMENTOS === with arcpy.da.InsertCursor(out_linhas, ["SHAPE@", "Descricao"]) as cursor:     for desc, lista_pontos in grupos_de_pontos.items():                  # Se tiver 3 ou mais pontos, fechamos o polígono contornando o centro         if len(lista_pontos) > 2:             centro_x = sum(p[0] for p in lista_pontos) / len(lista_pontos)             centro_y = sum(p[1] for p in lista_pontos) / len(lista_pontos)                          # Ordena por ângulo ao redor do centro geométrico (funcionará perfeito no UTM)             lista_pontos.sort(key=lambda p: math.atan2(p[1] - centro_y, p[0] - centro_x))                          # Fecha a forma geométrica             lista_pontos.append(lista_pontos[0])                      elif len(lista_pontos) < 2:             continue # Pula pontos isolados (postes, hidrômetros)          # Insere a linha         array_vertices = arcpy.Array()         for p in lista_pontos:             array_vertices.add(arcpy.Point(p[0], p[1]))                  linha_geom = arcpy.Polyline(array_vertices, sr_projetado)         cursor.insertRow([linha_geom, desc])  # === 6. ADICIONAR AO MAPA === try:     aprx = arcpy.mp.ArcGISProject("CURRENT")     mapa = aprx.activeMap     if mapa:         mapa.addDataFromPath(out_pontos_proj)         mapa.addDataFromPath(out_linhas)         print("🎨 Camadas atualizadas adicionadas ao mapa!") except Exception as e:     pass  print(f"✅ Sucesso! O arquivo de linhas finais foi gerado em: {out_linhas}")
import arcpy import os import math from collections import defaultdict  # === 1. CAMINHOS PARA OS SHAPEFILES === in_pontos = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_projetados.shp" out_segmentos = r"C:\Projetos\Caixias_Sul\Eduardo\segmentos_medidas.shp"  arcpy.env.overwriteOutput = True sr = arcpy.Describe(in_pontos).spatialReference  # === 2. CRIAR SHAPEFILE DE SEGMENTOS === print("1. Criando arquivo de segmentos de reta...") arcpy.management.CreateFeatureclass(     out_path=os.path.dirname(out_segmentos),     out_name=os.path.basename(out_segmentos),     geometry_type="POLYLINE",     spatial_reference=sr )  # Criar colunas para guardar a descrição, a distância e o texto final arcpy.management.AddField(out_segmentos, "Descricao", "TEXT", field_length=50) arcpy.management.AddField(out_segmentos, "Dist_pe", "DOUBLE") arcpy.management.AddField(out_segmentos, "Rotulo", "TEXT", field_length=100)  # === 3. AGRUPAR PONTOS E APLICAR O CONTORNO (RADIAL) === print("2. Lendo os pontos e organizando a geometria...") grupos_de_pontos = defaultdict(list)  with arcpy.da.SearchCursor(in_pontos, ["SHAPE@XY", "PointID", "Descriptio"]) as cursor:     for row in cursor:         x, y = row[0]         pt_id = row[1]         desc = row[2]                  if desc and str(desc).strip() != "":             grupos_de_pontos[desc].append((x, y, pt_id))  # === 4. CRIAR SEGMENTOS E CALCULAR DISTÂNCIAS === print("3. Calculando cotas e gerando os textos...") with arcpy.da.InsertCursor(out_segmentos, ["SHAPE@", "Descricao", "Rotulo", "Dist_pe"]) as cursor:     for desc, lista_pontos in grupos_de_pontos.items():                  # Aplica a mesma lógica de ordenação circular que fizemos antes         if len(lista_pontos) > 2:             centro_x = sum(p[0] for p in lista_pontos) / len(lista_pontos)             centro_y = sum(p[1] for p in lista_pontos) / len(lista_pontos)             lista_pontos.sort(key=lambda p: math.atan2(p[1] - centro_y, p[0] - centro_x))             lista_pontos.append(lista_pontos[0]) # Fecha o polígono                      # Percorre a lista desenhando uma linha de p1 até p2, depois de p2 até p3...         if len(lista_pontos) > 1:             for i in range(len(lista_pontos) - 1):                 p1 = lista_pontos[i]     # Ponto de origem                 p2 = lista_pontos[i+1]   # Ponto de destino                                  # Geometria da linha (segmento de 2 pontos)                 array = arcpy.Array([arcpy.Point(p1[0], p1[1]), arcpy.Point(p2[0], p2[1])])                 linha_geom = arcpy.Polyline(array, sr)                                  # Matemática da distância (Metros no UTM)                 dist_m = math.sqrt((p2[0]-p1[0])**2 + (p2[1]-p1[1])**2)                                  # Converter para Pés (US Survey Foot)                 dist_pe = dist_m * 3.28084                                  # Montar o texto exatamente como você pediu (arredondando para 1 casa decimal)                 texto_cota = f"Pto {p1[2]} a {p2[2]} = {dist_pe:.1f} pe"                                  # Salvar no shapefile                 cursor.insertRow([linha_geom, desc, texto_cota, dist_pe])  # === 5. ADICIONAR AO MAPA === try:     aprx = arcpy.mp.ArcGISProject("CURRENT")     mapa = aprx.activeMap     if mapa:         mapa.addDataFromPath(out_segmentos)         print("🎨 Segmentos adicionados ao mapa com sucesso!") except Exception as e:     pass  print(f"✅ Sucesso! O arquivo com as distâncias foi gerado em: {out_segmentos}")
import arcpy import os import math from collections import defaultdict  # === 1. CAMINHOS PARA OS SHAPEFILES === in_pontos = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_projetados.shp" out_segmentos = r"C:\Projetos\Caixias_Sul\Eduardo\segmentos_medidas_v1.shp"  arcpy.env.overwriteOutput = True sr = arcpy.Describe(in_pontos).spatialReference  # === 2. CRIAR SHAPEFILE DE SEGMENTOS === print("1. Criando arquivo de segmentos de reta...") arcpy.management.CreateFeatureclass(     out_path=os.path.dirname(out_segmentos),     out_name=os.path.basename(out_segmentos),     geometry_type="POLYLINE",     spatial_reference=sr )  # Criar colunas para guardar a descrição, a distância e o texto final arcpy.management.AddField(out_segmentos, "Descricao", "TEXT", field_length=50) arcpy.management.AddField(out_segmentos, "Dist_pe", "DOUBLE") arcpy.management.AddField(out_segmentos, "Rotulo", "TEXT", field_length=100)  # === 3. AGRUPAR PONTOS E APLICAR O CONTORNO (RADIAL) === print("2. Lendo os pontos e organizando a geometria...") grupos_de_pontos = defaultdict(list)  with arcpy.da.SearchCursor(in_pontos, ["SHAPE@XY", "PointID", "Descriptio"]) as cursor:     for row in cursor:         x, y = row[0]         pt_id = row[1]         desc = row[2]                  if desc and str(desc).strip() != "":             grupos_de_pontos[desc].append((x, y, pt_id))  # === 4. CRIAR SEGMENTOS E CALCULAR DISTÂNCIAS === print("3. Calculando cotas e gerando os textos limpos...") with arcpy.da.InsertCursor(out_segmentos, ["SHAPE@", "Descricao", "Rotulo", "Dist_pe"]) as cursor:     for desc, lista_pontos in grupos_de_pontos.items():                  # Aplica a mesma lógica de ordenação circular         if len(lista_pontos) > 2:             centro_x = sum(p[0] for p in lista_pontos) / len(lista_pontos)             centro_y = sum(p[1] for p in lista_pontos) / len(lista_pontos)             lista_pontos.sort(key=lambda p: math.atan2(p[1] - centro_y, p[0] - centro_x))             lista_pontos.append(lista_pontos[0]) # Fecha o polígono                      # Percorre a lista desenhando as linhas         if len(lista_pontos) > 1:             for i in range(len(lista_pontos) - 1):                 p1 = lista_pontos[i]                      p2 = lista_pontos[i+1]                                     # Geometria da linha                 array = arcpy.Array([arcpy.Point(p1[0], p1[1]), arcpy.Point(p2[0], p2[1])])                 linha_geom = arcpy.Polyline(array, sr)                                  # Matemática da distância (Metros para Pés)                 dist_m = math.sqrt((p2[0]-p1[0])**2 + (p2[1]-p1[1])**2)                 dist_pe = dist_m * 3.28084                                  # NOVO FORMATO DE TEXTO: Mostra apenas o valor, com 1 casa decimal, e troca ponto por vírgula                 texto_cota = f"{dist_pe:.1f} PE".replace('.', ',')                                  # Salvar no shapefile                 cursor.insertRow([linha_geom, desc, texto_cota, dist_pe])  # === 5. ADICIONAR AO MAPA === try:     aprx = arcpy.mp.ArcGISProject("CURRENT")     mapa = aprx.activeMap     if mapa:         mapa.addDataFromPath(out_segmentos)         print("🎨 Segmentos adicionados ao mapa com sucesso!") except Exception as e:     pass  print(f"✅ Sucesso! O arquivo com as distâncias foi gerado em: {out_segmentos}")
import arcpy import os import math from collections import defaultdict  # === 1. CAMINHOS PARA OS SHAPEFILES === in_pontos = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_projetados.shp" out_segmentos = r"C:\Projetos\Caixias_Sul\Eduardo\segmentos_medidas.shp" out_icones = r"C:\Projetos\Caixias_Sul\Eduardo\icones_medidas.shp" # NOVO ARQUIVO!  arcpy.env.overwriteOutput = True sr = arcpy.Describe(in_pontos).spatialReference  # === 2. CRIAR SHAPEFILES === print("1. Criando arquivos de segmentos e de ícones...")  # Shapefile de Linhas arcpy.management.CreateFeatureclass(os.path.dirname(out_segmentos), os.path.basename(out_segmentos), "POLYLINE", spatial_reference=sr) arcpy.management.AddField(out_segmentos, "Descricao", "TEXT")  # Shapefile de Pontos (Para os Ícones e Textos) arcpy.management.CreateFeatureclass(os.path.dirname(out_icones), os.path.basename(out_icones), "POINT", spatial_reference=sr) arcpy.management.AddField(out_icones, "Descricao", "TEXT", field_length=50) arcpy.management.AddField(out_icones, "Par_Pontos", "TEXT", field_length=50) # Ex: "3 e 27" arcpy.management.AddField(out_icones, "Rotulo", "TEXT", field_length=50)     # Ex: "176,5 PE" arcpy.management.AddField(out_icones, "Formato", "TEXT", field_length=50)    # Ex: "Quadrado"  # Lista de formatos que vamos alternar automaticamente lista_formatos = ["Quadrado", "Triangulo", "Circulo", "Cruz", "Losango", "Estrela"] mapa_formatos = {} indice_formato = 0  # === 3. AGRUPAR PONTOS === print("2. Lendo os pontos...") grupos_de_pontos = defaultdict(list)  with arcpy.da.SearchCursor(in_pontos, ["SHAPE@XY", "PointID", "Descriptio"]) as cursor:     for row in cursor:         x, y = row[0]         pt_id = row[1]         desc = row[2]         if desc and str(desc).strip() != "":             grupos_de_pontos[desc].append((x, y, pt_id))  # === 4. CRIAR SEGMENTOS E PONTOS MÉDIOS === print("3. Calculando pontos médios e gerando as cotas...")  cursor_linhas = arcpy.da.InsertCursor(out_segmentos, ["SHAPE@", "Descricao"]) cursor_icones = arcpy.da.InsertCursor(out_icones, ["SHAPE@", "Descricao", "Par_Pontos", "Rotulo", "Formato"])  for desc, lista_pontos in grupos_de_pontos.items():          # Define qual será a forma geométrica dessa descrição     if desc not in mapa_formatos:         mapa_formatos[desc] = lista_formatos[indice_formato % len(lista_formatos)]         indice_formato += 1          formato_atual = mapa_formatos[desc]          if len(lista_pontos) > 2:         centro_x = sum(p[0] for p in lista_pontos) / len(lista_pontos)         centro_y = sum(p[1] for p in lista_pontos) / len(lista_pontos)         lista_pontos.sort(key=lambda p: math.atan2(p[1] - centro_y, p[0] - centro_x))         lista_pontos.append(lista_pontos[0])              if len(lista_pontos) > 1:         for i in range(len(lista_pontos) - 1):             p1 = lista_pontos[i]                  p2 = lista_pontos[i+1]                             # 4.1 Linha             array = arcpy.Array([arcpy.Point(p1[0], p1[1]), arcpy.Point(p2[0], p2[1])])             linha_geom = arcpy.Polyline(array, sr)             cursor_linhas.insertRow([linha_geom, desc])                          # 4.2 Ponto Médio (Onde o ícone vai ficar)             mid_x = (p1[0] + p2[0]) / 2.0             mid_y = (p1[1] + p2[1]) / 2.0             ponto_geom = arcpy.Point(mid_x, mid_y)                          # Matemática da distância             dist_m = math.sqrt((p2[0]-p1[0])**2 + (p2[1]-p1[1])**2)             dist_pe = dist_m * 3.28084                          texto_cota = f"{dist_pe:.1f} PE".replace('.', ',')             texto_par = f"{p1[2]} e {p2[2]}"                          cursor_icones.insertRow([ponto_geom, desc, texto_par, texto_cota, formato_atual])  del cursor_linhas del cursor_icones  # === 5. ADICIONAR AO MAPA === try:     aprx = arcpy.mp.ArcGISProject("CURRENT")     mapa = aprx.activeMap     if mapa:         mapa.addDataFromPath(out_segmentos)         mapa.addDataFromPath(out_icones)         print("🎨 Camadas adicionadas ao mapa!") except Exception as e:     pass  print(f"✅ Sucesso! O arquivo de ícones foi gerado em: {out_icones}")
import arcpy import os import math from collections import defaultdict  # === 1. CAMINHOS PARA OS SHAPEFILES === in_pontos = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_projetados.shp" out_segmentos = r"C:\Projetos\Caixias_Sul\Eduardo\segmentos_medidas_v1.shp" out_icones = r"C:\Projetos\Caixias_Sul\Eduardo\icones_medidas.shp" # NOVO ARQUIVO!  arcpy.env.overwriteOutput = True sr = arcpy.Describe(in_pontos).spatialReference  # === 2. CRIAR SHAPEFILES === print("1. Criando arquivos de segmentos e de ícones...")  # Shapefile de Linhas arcpy.management.CreateFeatureclass(os.path.dirname(out_segmentos), os.path.basename(out_segmentos), "POLYLINE", spatial_reference=sr) arcpy.management.AddField(out_segmentos, "Descricao", "TEXT")  # Shapefile de Pontos (Para os Ícones e Textos) arcpy.management.CreateFeatureclass(os.path.dirname(out_icones), os.path.basename(out_icones), "POINT", spatial_reference=sr) arcpy.management.AddField(out_icones, "Descricao", "TEXT", field_length=50) arcpy.management.AddField(out_icones, "Par_Pontos", "TEXT", field_length=50) # Ex: "3 e 27" arcpy.management.AddField(out_icones, "Rotulo", "TEXT", field_length=50)     # Ex: "176,5 PE" arcpy.management.AddField(out_icones, "Formato", "TEXT", field_length=50)    # Ex: "Quadrado"  # Lista de formatos que vamos alternar automaticamente lista_formatos = ["Quadrado", "Triangulo", "Circulo", "Cruz", "Losango", "Estrela"] mapa_formatos = {} indice_formato = 0  # === 3. AGRUPAR PONTOS === print("2. Lendo os pontos...") grupos_de_pontos = defaultdict(list)  with arcpy.da.SearchCursor(in_pontos, ["SHAPE@XY", "PointID", "Descriptio"]) as cursor:     for row in cursor:         x, y = row[0]         pt_id = row[1]         desc = row[2]         if desc and str(desc).strip() != "":             grupos_de_pontos[desc].append((x, y, pt_id))  # === 4. CRIAR SEGMENTOS E PONTOS MÉDIOS === print("3. Calculando pontos médios e gerando as cotas...")  cursor_linhas = arcpy.da.InsertCursor(out_segmentos, ["SHAPE@", "Descricao"]) cursor_icones = arcpy.da.InsertCursor(out_icones, ["SHAPE@", "Descricao", "Par_Pontos", "Rotulo", "Formato"])  for desc, lista_pontos in grupos_de_pontos.items():          # Define qual será a forma geométrica dessa descrição     if desc not in mapa_formatos:         mapa_formatos[desc] = lista_formatos[indice_formato % len(lista_formatos)]         indice_formato += 1          formato_atual = mapa_formatos[desc]          if len(lista_pontos) > 2:         centro_x = sum(p[0] for p in lista_pontos) / len(lista_pontos)         centro_y = sum(p[1] for p in lista_pontos) / len(lista_pontos)         lista_pontos.sort(key=lambda p: math.atan2(p[1] - centro_y, p[0] - centro_x))         lista_pontos.append(lista_pontos[0])              if len(lista_pontos) > 1:         for i in range(len(lista_pontos) - 1):             p1 = lista_pontos[i]                  p2 = lista_pontos[i+1]                             # 4.1 Linha             array = arcpy.Array([arcpy.Point(p1[0], p1[1]), arcpy.Point(p2[0], p2[1])])             linha_geom = arcpy.Polyline(array, sr)             cursor_linhas.insertRow([linha_geom, desc])                          # 4.2 Ponto Médio (Onde o ícone vai ficar)             mid_x = (p1[0] + p2[0]) / 2.0             mid_y = (p1[1] + p2[1]) / 2.0             ponto_geom = arcpy.Point(mid_x, mid_y)                          # Matemática da distância             dist_m = math.sqrt((p2[0]-p1[0])**2 + (p2[1]-p1[1])**2)             dist_pe = dist_m * 3.28084                          texto_cota = f"{dist_pe:.1f} PE".replace('.', ',')             texto_par = f"{p1[2]} e {p2[2]}"                          cursor_icones.insertRow([ponto_geom, desc, texto_par, texto_cota, formato_atual])  del cursor_linhas del cursor_icones  # === 5. ADICIONAR AO MAPA === try:     aprx = arcpy.mp.ArcGISProject("CURRENT")     mapa = aprx.activeMap     if mapa:         mapa.addDataFromPath(out_segmentos)         mapa.addDataFromPath(out_icones)         print("🎨 Camadas adicionadas ao mapa!") except Exception as e:     pass  print(f"✅ Sucesso! O arquivo de ícones foi gerado em: {out_icones}")
import arcpy import os import math from collections import defaultdict  # === 1. CAMINHOS PARA OS SHAPEFILES === in_pontos = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_projetados.shp" out_segmentos = r"C:\Projetos\Caixias_Sul\Eduardo\segmentos_medidas_v2.shp"  arcpy.env.overwriteOutput = True sr = arcpy.Describe(in_pontos).spatialReference  # === 2. CRIAR SHAPEFILE DE SEGMENTOS === print("1. Criando arquivo de segmentos de reta...") arcpy.management.CreateFeatureclass(     out_path=os.path.dirname(out_segmentos),     out_name=os.path.basename(out_segmentos),     geometry_type="POLYLINE",     spatial_reference=sr )  # Criar colunas para guardar a descrição, a distância e o texto final arcpy.management.AddField(out_segmentos, "Descricao", "TEXT", field_length=50) arcpy.management.AddField(out_segmentos, "Dist_pe", "DOUBLE") arcpy.management.AddField(out_segmentos, "Rotulo", "TEXT", field_length=100)  # === 3. AGRUPAR PONTOS E APLICAR O CONTORNO (RADIAL) === print("2. Lendo os pontos e organizando a geometria...") grupos_de_pontos = defaultdict(list)  with arcpy.da.SearchCursor(in_pontos, ["SHAPE@XY", "PointID", "Descriptio"]) as cursor:     for row in cursor:         x, y = row[0]         pt_id = row[1]         desc = row[2]                  if desc and str(desc).strip() != "":             grupos_de_pontos[desc].append((x, y, pt_id))  # === 4. CRIAR SEGMENTOS E CALCULAR DISTÂNCIAS === print("3. Calculando cotas e gerando os textos limpos...") with arcpy.da.InsertCursor(out_segmentos, ["SHAPE@", "Descricao", "Rotulo", "Dist_pe"]) as cursor:     for desc, lista_pontos in grupos_de_pontos.items():                  # Aplica a mesma lógica de ordenação circular         if len(lista_pontos) > 2:             centro_x = sum(p[0] for p in lista_pontos) / len(lista_pontos)             centro_y = sum(p[1] for p in lista_pontos) / len(lista_pontos)             lista_pontos.sort(key=lambda p: math.atan2(p[1] - centro_y, p[0] - centro_x))             lista_pontos.append(lista_pontos[0]) # Fecha o polígono                      # Percorre a lista desenhando as linhas         if len(lista_pontos) > 1:             for i in range(len(lista_pontos) - 1):                 p1 = lista_pontos[i]                      p2 = lista_pontos[i+1]                                     # Geometria da linha                 array = arcpy.Array([arcpy.Point(p1[0], p1[1]), arcpy.Point(p2[0], p2[1])])                 linha_geom = arcpy.Polyline(array, sr)                                  # Matemática da distância (Metros para Pés)                 dist_m = math.sqrt((p2[0]-p1[0])**2 + (p2[1]-p1[1])**2)                 dist_pe = dist_m * 3.28084                                  # NOVO FORMATO DE TEXTO: Mostra apenas o valor, com 1 casa decimal, e troca ponto por vírgula                 texto_cota = f"{dist_pe:.1f} PE".replace('.', ',')                                  # Salvar no shapefile                 cursor.insertRow([linha_geom, desc, texto_cota, dist_pe])  # === 5. ADICIONAR AO MAPA === try:     aprx = arcpy.mp.ArcGISProject("CURRENT")     mapa = aprx.activeMap     if mapa:         mapa.addDataFromPath(out_segmentos)         print("🎨 Segmentos adicionados ao mapa com sucesso!") except Exception as e:     pass  print(f"✅ Sucesso! O arquivo com as distâncias foi gerado em: {out_segmentos}")
import arcpy  # === 1. CAMINHO DO ARQUIVO === # Vamos usar o arquivo de pontos projetados que já está no seu mapa in_pontos = r"C:\Projetos\Caixias_Sul\Eduardo\pontos_projetados.shp"  # === 2. CRIAR A COLUNA "FORMATO" === print("1. Preparando a tabela de atributos...") try:     arcpy.management.AddField(in_pontos, "Formato", "TEXT", field_length=50) except Exception:     print("Nota: O campo 'Formato' já existe, atualizando os dados...")  # Lista de formatos disponíveis para distribuir lista_formatos = ["Quadrado", "Triangulo", "Circulo", "Cruz", "Losango", "Estrela", "Pentagono"] mapa_formatos = {} indice_formato = 0  # === 3. ATUALIZAR CADA PONTO === print("2. Analisando as descrições e distribuindo os ícones...")  # Usamos um UpdateCursor porque vamos modificar um arquivo existente with arcpy.da.UpdateCursor(in_pontos, ["Descriptio", "Formato"]) as cursor:     for row in cursor:         desc = row[0]                  # Ignora se a descrição estiver vazia         if not desc or str(desc).strip() == "":             continue                      # Se for uma descrição nova (ex: a primeira vez que o script lê 'bc'),          # ele pega um formato da lista e guarda na memória         if desc not in mapa_formatos:             mapa_formatos[desc] = lista_formatos[indice_formato % len(lista_formatos)]             indice_formato += 1                      # Grava o formato escolhido na coluna correspondente daquele ponto         row[1] = mapa_formatos[desc]         cursor.updateRow(row)  print("✅ Sucesso! Seus pontos agora estão categorizados por formato.")
